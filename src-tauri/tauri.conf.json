{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brace",
  "version": "0.1.1",
  "identifier": "com.brace.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brace",
        "width": 1000,
        "height": 680,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/statusline-writer.cjs"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Albert0x/Brace/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOUJCMTYwNUM4N0I0NkEKUldScXRJZGNZTEdiMnExdVM4Z1BXZWJhdWFGbWljMU01WkdoTjlNalpqMmFQcW1XYzltczNFRkIK"
    }
  }
}
